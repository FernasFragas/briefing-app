# Briefing App local environment template
#
# Browser/host URLs:
# - FastAPI app health: http://localhost:8000/health
# - n8n editor and Assistant: http://localhost:5678
#
# Docker-internal URLs used by n8n:
# - Daily briefing run: http://app:8000/run/daily
# - Weekly briefing run: http://app:8000/run/weekly
# - Static delivery: http://app:8000/delivery/static
# - n8n Assistant sandbox: http://sandbox-api:8080
# - n8n Assistant SearXNG: http://searxng:8080
#
# Ollama URLs:
# - App to Ollama Cloud native API: https://ollama.com/api/chat
# - n8n Assistant to local Ollama OpenAI-compatible API: http://host.docker.internal:11434/v1
# - n8n to local Ollama native API, only for direct HTTP Request nodes: http://host.docker.internal:11434/api/chat
#
# Key variables:
# - APP_RUN_TOKEN: bearer token n8n sends to the FastAPI app.
# - SANDBOX_API_KEYS: accepted API keys for the sandbox API.
# - N8N_SANDBOX_SERVICE_API_KEY: key n8n sends to sandbox-api; must match SANDBOX_API_KEYS.
# - SANDBOX_API_RUNNER_REGISTRATION_TOKEN: token used by sandbox-runner-1 to register.
# - SANDBOX_API_RUNNER_API_KEY: internal runner API key used by the sandbox stack.
# - SEARXNG_SECRET: SearXNG instance secret.
# - POSTGRES_PASSWORD: local Postgres password.
# - ALPHA_VANTAGE_API_KEY, FMP_API_KEY: live market-data provider keys.
# - ALPHA_VANTAGE_PLAN, FMP_PLAN, TWELVE_DATA_PLAN: plan tier, gating premium endpoints
#   and quotas.
# - FRED_API_KEY: macro readings and release calendar (PA9).
# - FINNHUB_API_KEY: news, analyst signals, transcript probe (PA3, PA8, PA10).
# - TWELVE_DATA_API_KEY: daily OHLCV for FMP-gated symbols (PA4).
# - QUIVER_API_KEY: optional, per-ticker congressional history (PA6).
#   All four are free tiers and all four may be left blank: an empty key reports
#   `no_credentials` at preflight instead of failing the run.
# - OLLAMA_API_KEY: Ollama Cloud key used by the FastAPI app.
# - OPENAI_API_KEY, ANTHROPIC_API_KEY: legacy/optional LLM provider keys.
# - N8N_BLOCK_ENV_ACCESS_IN_NODE=false: lets the local workflow read $env values.

# App runtime and n8n workflow URLs.
APP_ENV=development
APP_RUN_TOKEN=change-me-local-token
APP_RUN_URL=http://app:8000/run/daily
APP_DAILY_RUN_URL=http://app:8000/run/daily
APP_WEEKLY_RUN_URL=http://app:8000/run/weekly
STATIC_DELIVERY_URL=http://app:8000/delivery/static
MARKET_HOLIDAYS=
GENERIC_TIMEZONE=Europe/Lisbon

# n8n Assistant sandbox and web search.
# These URLs are Docker-internal service names, not browser URLs.
# Use your own values in .env.
# Keep N8N_SANDBOX_SERVICE_API_KEY equal to one value in SANDBOX_API_KEYS.
SANDBOX_API_KEYS=change-me-sandbox-api-key
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=change-me-sandbox-registration-token
SANDBOX_API_RUNNER_API_KEY=change-me-sandbox-runner-key
N8N_SANDBOX_SERVICE_API_KEY=change-me-sandbox-api-key
N8N_SANDBOX_SERVICE_URL=http://sandbox-api:8080
N8N_ENABLED_MODULES=instance-ai
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_INSTANCE_AI_SANDBOX_ENABLED=true
N8N_INSTANCE_AI_SANDBOX_PROVIDER=n8n-sandbox
N8N_INSTANCE_AI_SANDBOX_IMAGE=ghcr.io/n8n-io/n8n-sandbox-service-sandbox:latest
SEARXNG_SECRET=change-me-searxng-secret
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080

# Local Postgres credentials.
# docker-compose.yml builds DATABASE_URL for the app as:
# postgresql+psycopg://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB
POSTGRES_USER=briefing
POSTGRES_PASSWORD=change-me
POSTGRES_DB=briefing

# Market-data and LLM provider keys.
# Leave provider keys blank for fixture-mode local runs.
# Set LLM_PROVIDER=ollama to use Ollama Cloud through the FastAPI app.
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=

# Phase B provider keys, all free tiers. Each is blank until you sign up; a blank key
# reports `no_credentials` at preflight rather than failing a run, so leaving them empty
# is a supported state. Verdicts and free-tier terms are in docs/alternatives/.
#
# FRED - macro readings and the release calendar (PA9 adopt, unblocks I5/PB9).
#   Official primary data replacing a sole aggregator, which also upgrades S_M's
#   source-quality label. Key: https://fredaccount.stlouisfed.org/apikeys
#   (free account required; docs at https://fred.stlouisfed.org/docs/api/api_key.html)
#
#   OPTIONAL - there is a keyless path. `fredgraph.csv` serves every series PA9 adopted
#   from the same host with no account (verified 2026-08-31, all 8 series HTTP 200):
#     https://fred.stlouisfed.org/graph/fredgraph.csv?id=CPIAUCSL
#   What a key still buys is the release calendar (`release/dates`), which the CSV path
#   cannot serve and which no free keyless source covers. See
#   docs/alternatives/pa9-macro-keyless-alternative.md for the full trade.
FRED_API_KEY=

# Finnhub - company news and analyst recommendation trends (PA3 + PA8, wired 2026-09-01
#   as I6/I9/I11). 60 req/min free against Alpha Vantage's 25/day, which is the whole
#   point. Three limits, all measured rather than assumed:
#     - Free tier is US-only. RHM.DE and LDO.MI answer 403; the client refuses an
#       exchange-suffixed symbol before spending a request.
#     - It does not score its own news (/news-sentiment is 403), so tone is derived
#       locally by providers/news_tone.py and labelled as such.
#     - Price targets and transcripts are 403 too, so those stay on FMP / unsourced.
#   Key: https://finnhub.io/register
FINNHUB_API_KEY=

# Twelve Data - daily OHLCV for the six FMP-gated US symbols (PA4, wired 2026-09-02
#   as I8/I13). Chosen over Tiingo after the coverage probe: AVGO, ORCL, MU, QQQ,
#   CRWV and AMAT all answer 402 on FMP's free plan and resolve on Twelve Data.
#   RHM.DE/LDO.MI remain paid-plan gated and are an A2 universe decision.
#   Key: https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=

# Quiver - per-ticker congressional trading history (optional; unblocks the per-symbol
#   half of I7/PB6). NOT required for political_flow: FMP's `senate-latest` and
#   `house-latest` are entitled on the existing free key and cover the leg at 2 requests
#   per run. What Quiver adds is the per-ticker view FMP gates - `senate-trades?symbol=`
#   and `house-trades?symbol=` both answer 402 - so it turns a sparse rolling feed into
#   direct per-name history without waiting for one to accumulate.
#   Endpoint verified live and key-gated 2026-08-31 (HTTP 401, clean JSON error):
#   https://api.quiverquant.com/beta/historical/congresstrading/{ticker}
#   Key: https://www.quiverquant.com/pricing/
#   Retail momentum does NOT need this - ApeWisdom is keyless (PA6).
QUIVER_API_KEY=

# Provider plan tier: `free` (default) or `paid`.
# On `free` the pipeline refuses endpoints the plan cannot serve before sending the
# request, so a metered key is never spent being told no. Set `paid` once a key is
# upgraded; that also lifts the daily request cap below.
ALPHA_VANTAGE_PLAN=free
FMP_PLAN=free
TWELVE_DATA_PLAN=free

# Request budgets, enforced before a call leaves the process and persisted per day in
# $BRIEFING_DATA_DIR/provider_budget. Defaults match the observed free tiers:
# Alpha Vantage 25 requests/day at 1 request/sec; FMP 250/day.
# Twelve Data Basic allows 800/day and 8 credits/minute for one-symbol time_series.
# Set to `none` for no daily cap. A live run costs roughly 5 Alpha Vantage requests and
# 4 FMP requests per ticker, plus ~7 shared FMP macro requests per run.
ALPHA_VANTAGE_DAILY_REQUEST_BUDGET=25
ALPHA_VANTAGE_MIN_REQUEST_INTERVAL_SECONDS=1.2
FMP_DAILY_REQUEST_BUDGET=250
FMP_MIN_REQUEST_INTERVAL_SECONDS=0.35
TWELVE_DATA_DAILY_REQUEST_BUDGET=800
TWELVE_DATA_MIN_REQUEST_INTERVAL_SECONDS=7.6
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=

# App config, cache, output, timeout, and provider user-agent paths.
BRIEFING_CONFIG_PATH=/app/config/config.example.yaml
BRIEFING_SOURCE_REGISTRY_PATH=/app/config/source_registry.yaml
BRIEFING_DATA_DIR=/app/data
BRIEFING_OUTPUT_DIR=/app/output
BRIEFING_HTTP_TIMEOUT_SECONDS=10
# SEC EDGAR requires a real contact address in the User-Agent and throttles or blocks a
# generic one without an error you can see in the payload. Replace the placeholder below
# with your own address; preflight flags it as a placeholder until you do.
BRIEFING_USER_AGENT="briefing-app/0.1 contact@example.com"
